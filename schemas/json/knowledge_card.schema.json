{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lashos.io/schemas/knowledge_card.schema.json",
  "title": "LashOS Knowledge Card",
  "description": "A single canonical concept, synthesized from a set of immutable claims. One card = one concept.",
  "type": "object",
  "required": [
    "id", "concept_id", "title", "version", "schema_version",
    "domain", "primary_path", "facets",
    "definition", "summary",
    "confidence", "evidence", "sources", "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^kc_[A-Z]{3}_[a-z0-9-]{1,60}$",
      "description": "kc_<DOMAIN>_<slug>. Frozen at creation; retitling never changes it."
    },
    "concept_id": { "type": "string", "pattern": "^cpt_[A-Z]{3}_[a-z0-9-]{1,60}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "aliases": { "type": "array", "items": { "type": "string" }, "default": [] },
    "version": { "type": "integer", "minimum": 1 },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "taxonomy_version": { "type": "string" },

    "domain": {
      "type": "string",
      "enum": ["ANA","HLT","ASM","STY","MAP","RET","ADH","APP","PRD","ADJ",
               "CON","PSY","BIZ","MKT","EDU","IND","LOS"]
    },
    "primary_path": {
      "type": "array", "items": { "type": "string" }, "minItems": 2,
      "description": "[domain display name, subcategory]"
    },
    "secondary_paths": {
      "type": "array", "items": { "type": "array", "items": { "type": "string" } }, "default": []
    },

    "facets": {
      "type": "object",
      "required": ["knowledge_type","epistemic_status","risk_tier","skill_level",
                   "audience","service_lifecycle","context_sensitivity","actionability"],
      "additionalProperties": false,
      "properties": {
        "knowledge_type": {
          "type": "string",
          "enum": ["definition","principle","mechanism","technique","protocol","heuristic",
                   "parameter","diagnostic","contraindication","metric","framework","script",
                   "case_study","opinion","myth"]
        },
        "epistemic_status": {
          "type": "string",
          "enum": ["established_science","manufacturer_spec","industry_consensus","contested",
                   "emerging","anecdotal","folklore","debunked"]
        },
        "risk_tier": {
          "type": "integer", "minimum": 0, "maximum": 4,
          "description": "0 informational, 1 operational, 2 client safety, 3 medical adjacent, 4 regulatory"
        },
        "skill_level": {
          "type": "string",
          "enum": ["foundation","intermediate","advanced","specialist","educator","business_owner"]
        },
        "audience": {
          "type": "array", "minItems": 1,
          "items": { "type": "string",
                     "enum": ["student","artist","educator","salon_owner","client_facing","supplier"] }
        },
        "service_lifecycle": {
          "type": "array",
          "items": { "type": "string",
                     "enum": ["marketing","enquiry","consultation","assessment","design",
                              "application","aftercare","fill","removal","retention_followup",
                              "back_office"] }
        },
        "context_sensitivity": {
          "type": "array",
          "items": { "type": "string",
                     "enum": ["climate","humidity","temperature","skin_type","lash_health",
                              "region","regulation","product_specific","skill_dependent","none"] }
        },
        "actionability": {
          "type": "string",
          "enum": ["informational","advisory","actionable","procedural","decisional"]
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" }, "default": [] },

    "definition": {
      "type": "string", "minLength": 20, "maxLength": 400,
      "description": "One sentence, decontextualised, stands alone."
    },
    "summary": { "type": "string", "minLength": 40, "maxLength": 1200 },
    "mechanism": { "type": ["string","null"], "description": "Why it is true — the causal chain." },
    "practical_application": { "type": ["string","null"] },

    "implementation_steps": {
      "type": "array", "default": [],
      "items": {
        "type": "object",
        "required": ["step","action"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "action": { "type": "string" },
          "detail": { "type": ["string","null"] },
          "claim_refs": { "type": "array", "items": { "$ref": "#/$defs/claimId" } }
        }
      }
    },
    "preconditions": { "type": "array", "items": { "type": "string" }, "default": [] },

    "common_mistakes": {
      "type": "array", "default": [],
      "items": {
        "type": "object",
        "required": ["mistake"],
        "properties": {
          "mistake": { "type": "string" },
          "why_it_happens": { "type": ["string","null"] },
          "consequence": { "type": ["string","null"] },
          "correction": { "type": ["string","null"] },
          "claim_refs": { "type": "array", "items": { "$ref": "#/$defs/claimId" } }
        }
      }
    },
    "exceptions": {
      "type": "array", "default": [],
      "items": {
        "type": "object",
        "required": ["condition","behaviour"],
        "properties": {
          "condition": { "type": "string" },
          "behaviour": { "type": "string" },
          "claim_refs": { "type": "array", "items": { "$ref": "#/$defs/claimId" } }
        }
      }
    },
    "edge_cases": { "type": "array", "items": { "type": "string" }, "default": [] },
    "counter_indications": {
      "type": "array", "default": [],
      "description": "Situations where this knowledge must NOT be applied.",
      "items": {
        "type": "object",
        "required": ["situation","reason"],
        "properties": {
          "situation": { "type": "string" },
          "reason": { "type": "string" },
          "severity": { "type": "string", "enum": ["low","moderate","high","critical"] }
        }
      }
    },

    "parameters": {
      "type": "array", "default": [],
      "items": { "$ref": "https://lashos.io/schemas/parameter.schema.json" }
    },

    "contradictions": {
      "type": "array", "default": [],
      "items": {
        "type": "object",
        "required": ["id","statement","resolution_status"],
        "properties": {
          "id": { "type": "string", "pattern": "^ctr_[0-9a-f]{12}$" },
          "statement": { "type": "string" },
          "supporting_claims": { "type": "array", "items": { "$ref": "#/$defs/claimId" } },
          "opposing_claims": { "type": "array", "items": { "$ref": "#/$defs/claimId" } },
          "resolution_status": {
            "type": "string",
            "enum": ["unresolved","context_dependent","resolved","superseded","not_a_conflict"]
          },
          "resolution_note": { "type": ["string","null"] }
        }
      }
    },
    "alternative_viewpoints": {
      "type": "array", "default": [],
      "items": {
        "type": "object",
        "required": ["viewpoint"],
        "properties": {
          "viewpoint": { "type": "string" },
          "held_by": { "type": "array", "items": { "type": "string" } },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },

    "confidence": {
      "type": "object",
      "required": ["score","band","formula_version"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "band": { "type": "string", "enum": ["very_low","low","moderate","high","very_high"] },
        "computed_at": { "type": "string", "format": "date-time" },
        "formula_version": { "type": "string" },
        "components": {
          "type": "object",
          "properties": {
            "evidence_strength": { "$ref": "#/$defs/unitInterval" },
            "source_quality":    { "$ref": "#/$defs/unitInterval" },
            "consensus":         { "$ref": "#/$defs/unitInterval" },
            "corroboration":     { "$ref": "#/$defs/unitInterval" },
            "recency":           { "$ref": "#/$defs/unitInterval" },
            "specificity":       { "$ref": "#/$defs/unitInterval" }
          }
        },
        "penalties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/unitInterval" } }
      }
    },

    "evidence": {
      "type": "object",
      "required": ["claim_count","supporting_claims","contradicting_claims","independent_source_groups"],
      "properties": {
        "claim_count": { "type": "integer", "minimum": 1 },
        "supporting_claims": { "type": "integer", "minimum": 0 },
        "contradicting_claims": { "type": "integer", "minimum": 0 },
        "independent_source_groups": {
          "type": "integer", "minimum": 1,
          "description": "Distinct independence groups — NOT raw source count. See doc 05 §7."
        },
        "distinct_creators": { "type": "integer", "minimum": 1 },
        "highest_evidence_tier": { "$ref": "#/$defs/evidenceTier" },
        "evidence_ledger": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tier","count"],
            "properties": {
              "tier": { "$ref": "#/$defs/evidenceTier" },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "date_range": {
          "type": "array", "items": { "type": "string", "format": "date" },
          "minItems": 2, "maxItems": 2
        }
      }
    },

    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id","platform","stance"],
        "properties": {
          "source_id": { "type": "string" },
          "creator_id": { "type": ["string","null"] },
          "platform": { "type": "string" },
          "published_at": { "type": ["string","null"], "format": "date" },
          "timestamps": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
          },
          "claim_ids": { "type": "array", "items": { "$ref": "#/$defs/claimId" } },
          "stance": { "type": "string", "enum": ["supports","contradicts","qualifies","neutral"] },
          "reliability_score": { "$ref": "#/$defs/unitInterval" }
        }
      }
    },
    "key_quotes": {
      "type": "array", "default": [],
      "items": {
        "type": "object",
        "required": ["claim_id","quote","attribution"],
        "properties": {
          "claim_id": { "$ref": "#/$defs/claimId" },
          "quote": { "type": "string", "description": "Verbatim. Must match source raw_text exactly." },
          "attribution": { "type": "string" },
          "deep_link": { "type": ["string","null"], "format": "uri" }
        }
      }
    },

    "entities": { "type": "array", "items": { "type": "string" }, "default": [] },
    "relations": {
      "type": "array", "default": [],
      "items": {
        "type": "object",
        "required": ["predicate","object"],
        "properties": {
          "predicate": { "type": "string" },
          "object": { "type": "string" },
          "strength": { "$ref": "#/$defs/unitInterval" },
          "polarity": { "type": "string", "enum": ["positive","negative","nonlinear","neutral"] },
          "confidence": { "$ref": "#/$defs/unitInterval" }
        }
      }
    },
    "related_concepts": { "type": "array", "items": { "type": "string" }, "default": [] },
    "prerequisites": { "type": "array", "items": { "type": "string" }, "default": [] },
    "supersedes": { "type": "array", "items": { "type": "string" }, "default": [] },
    "superseded_knowledge": {
      "type": "array", "default": [],
      "items": {
        "type": "object",
        "required": ["statement","superseded_by","reason"],
        "properties": {
          "statement": { "type": "string" },
          "held_until": { "type": ["string","null"] },
          "superseded_by": { "type": "string" },
          "reason": { "type": "string" },
          "historical_claims": { "type": "array", "items": { "$ref": "#/$defs/claimId" } }
        }
      }
    },

    "lashos": {
      "type": "object",
      "description": "Product-layer annotations: how LashOS features may use this knowledge.",
      "properties": {
        "usable": { "type": "boolean" },
        "usable_rationale": { "type": "string" },
        "gating": {
          "type": "object",
          "properties": {
            "min_confidence_to_assert": { "$ref": "#/$defs/unitInterval" },
            "requires_citation": { "type": "boolean" },
            "requires_human_review": { "type": "boolean" },
            "requires_disclaimer": { "type": "boolean" }
          }
        },
        "ai_features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["feature","use"],
            "properties": {
              "feature": {
                "type": "string",
                "enum": ["lash_educator","consultation_assistant","retention_expert",
                         "styling_assistant","product_recommender","troubleshooting_assistant",
                         "business_coach","course_generator","certification_platform"]
              },
              "use": { "type": "string" },
              "integration": {
                "type": "string",
                "enum": ["parameter_lookup","diagnostic_tree_node","rule_filter",
                         "retrieval_context","curriculum_node","assessment_item",
                         "prediction_feature"]
              }
            }
          }
        },
        "decision_support":        { "type": "array", "items": { "type": "string" } },
        "course_modules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "module": { "type": "string" },
              "level": { "type": "string" },
              "role": { "type": "string", "enum": ["core_concept","supporting","enrichment","assessment"] }
            }
          }
        },
        "client_intelligence":     { "type": "array", "items": { "type": "string" } },
        "retention_intelligence":  { "type": "array", "items": { "type": "string" } },
        "styling_intelligence":    { "type": "array", "items": { "type": "string" } },
        "business_intelligence":   { "type": "array", "items": { "type": "string" } }
      }
    },

    "status": { "type": "string", "enum": ["draft","in_review","published","contested","deprecated"] },
    "review": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean" },
        "reviewed_by": { "type": ["string","null"] },
        "reviewed_at": { "type": ["string","null"], "format": "date-time" }
      }
    },
    "human_override_md": { "type": ["string","null"] },
    "human_override_present": { "type": "boolean", "default": false },
    "vault_path": { "type": ["string","null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "last_evidence_at": { "type": ["string","null"], "format": "date" }
  },

  "$defs": {
    "unitInterval": { "type": "number", "minimum": 0, "maximum": 1 },
    "claimId": { "type": "string", "pattern": "^clm_[0-9a-f]{12}$" },
    "evidenceTier": {
      "type": "string",
      "enum": ["peer_reviewed","regulatory","manufacturer_spec","controlled_test",
               "deliberated_consensus","structured_experience","expert_assertion","anecdote","hearsay","marketing"]
    }
  },

  "allOf": [
    {
      "if": { "properties": { "facets": { "properties": { "risk_tier": { "minimum": 3 } } } } },
      "then": {
        "properties": {
          "review": { "required": ["reviewed_at"] },
          "lashos": {
            "properties": {
              "gating": {
                "properties": {
                  "requires_human_review": { "const": true },
                  "requires_citation": { "const": true }
                }
              }
            }
          }
        },
        "description": "Risk tier 3+ cannot be published without human review and forced citation."
      }
    }
  ]
}
