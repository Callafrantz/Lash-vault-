# ── Working data — never committed ────────────────────────────────────────
data/raw/
data/interim/
data/processed/
!data/**/.gitkeep

# The generated vault is its own git repository (docs/08 §10).
vault/*
!vault/.gitkeep
.lke-staging/

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# ── Secrets & local config ────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
credentials.json

# ── Tooling ───────────────────────────────────────────────────────────────
.prefect/
.DS_Store
*.log
